# Aucune valeur par defaut pour les secrets : install.sh les genere aleatoirement.
# Une valeur d'exemple reprise telle quelle ferait deployer le meme identifiant
# a tous les candidats sur le serveur partage.

# --- Ports (plage attribuee par mail, en 127.0.0.1 uniquement) ---
POSTGRES_PORT=
MINIO_API_PORT=
MINIO_CONSOLE_PORT=

# --- PostgreSQL ---
POSTGRES_USER=portail
POSTGRES_PASSWORD=
POSTGRES_DB=portail

# --- MinIO ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Application ---
# Poivre du HMAC des tokens de lien. Le perdre invalide TOUS les liens en
# circulation : il doit etre sauvegarde, pas seulement cache.
ACCESS_LINK_TOKEN_PEPPER=

# Compte avocat de demonstration, cree au seed.
DEMO_LAWYER_EMAIL=
DEMO_LAWYER_PASSWORD=
