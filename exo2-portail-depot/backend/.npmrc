# Versions exactes par defaut : une plage `^` laisse un `npm install` tirer une
# version qu'on n'a jamais testee, y compris une version compromise publiee
# entre-temps. On veut que toute montee de version soit un geste delibere.
save-exact=true

# Les scripts d'installation sont le principal vecteur de compromission de la
# chaine d'approvisionnement npm : un paquet execute du code arbitraire a
# l'installation. On les refuse par defaut et on approuve au cas par cas.
ignore-scripts=true
