{
  // Les tests de derive sont les SEULS fichiers du front qui lisent des sources
  // du backend : `contracts_drift` compare les types, `security_policy_drift`
  // compare les valeurs recopiees. Ils ont leur propre tsconfig parce que la
  // rigueur du front n'a pas a s'appliquer au backend : `noUncheckedIndexedAccess` et
  // `exactOptionalPropertyTypes` sont des choix de CE projet-ci, et les imposer
  // a l'autre ferait echouer un typecheck qui n'a rien a voir avec la derive.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": false,
    "verbatimModuleSyntax": false,
    "moduleResolution": "bundler"
  },
  // `exclude` est redeclare, et pas par coquetterie : il est herite du
  // tsconfig de base, qui ecarte justement ces fichiers — et un `exclude` hérité
  // filtre l'`include` local. Sans cette ligne, ce projet ne compile aucun
  // fichier et les tests de derive passent toujours, sans rien verifier.
  "exclude": [],
  "include": [
    "src/api/contracts.ts",
    "test/api/contracts_drift.spec.ts",
    "test/api/security_policy_drift.spec.ts"
  ]
}
