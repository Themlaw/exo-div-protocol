# Aucune valeur par defaut pour les secrets : install.sh les genere aleatoirement.
# Une valeur d'exemple reprise telle quelle ferait deployer le meme identifiant
# a tous les candidats sur le serveur partage.

# --- Ports (plage attribuee par mail, en 127.0.0.1 uniquement) ---
POSTGRES_PORT=
MINIO_API_PORT=
MINIO_CONSOLE_PORT=

# --- PostgreSQL ---
POSTGRES_USER=portail
POSTGRES_PASSWORD=
POSTGRES_DB=portail

# --- MinIO ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Application ---
# Les noms sont ceux de ENVIRONMENT_VARIABLE_NAMES dans
# backend/src/config/environment.ts, qui en est la source unique.
NODE_ENV=production

# Construite par install.sh a partir des valeurs POSTGRES_* ci-dessus.
DATABASE_URL=

MINIO_ENDPOINT=

# URL publique du portail, telle que le navigateur la voit. Elle fixe l'origine
# de confiance de l'authentification (quelles pages peuvent poster vers l'API)
# et le domaine du cookie de session. En production, https obligatoire et pas de
# boucle locale : sans TLS le cookie de session ne peut pas etre pose en Secure.
PUBLIC_BASE_URL=

# Jeton porteur que MinIO envoie dans l'en-tete Authorization de ses
# notifications d'objet. MinIO ne signe pas le corps : ce secret est une
# deuxieme barriere, la premiere etant l'isolation reseau (route non publiee
# par Traefik). 64 caracteres hexadecimaux minimum, soit 32 octets.
INTERNAL_STORAGE_WEBHOOK_SECRET=

# Poivre du HMAC des tokens de lien. 64 caracteres hexadecimaux minimum, soit
# 32 octets : la taille de sortie de SHA-256. Le perdre invalide TOUS les liens
# en circulation : il doit etre sauvegarde, pas seulement cache.
ACCESS_LINK_TOKEN_PEPPER=

# Nombre de relais de confiance a remonter dans X-Forwarded-For pour etablir
# l'adresse du client. On part de la DROITE de la chaine : le debut est
# entierement controle par le client.
#   1  = derriere notre Traefik, qui termine le TLS et ajoute l'en-tete.
#   0  = mode degrade. Sur la VM d'exercice le 443 est en passthrough SNI :
#        le proxy frontal ne dechiffre rien, donc n'ajoute aucun en-tete, et
#        toutes les requetes partagent son adresse. La limitation par couple
#        (compte, adresse) s'effondre alors sur la limitation par compte, qui
#        RETARDE sans jamais refuser — sans quoi n'importe qui fermerait le
#        portail a tout le monde.
# Doit etre un entier positif ou nul. Toute autre valeur empeche le demarrage.
TRUSTED_PROXY_HOP_COUNT=

# Compte avocat de demonstration, cree au seed. En production, l'application
# refuse de demarrer sur un domaine d'essai (.test, example.com) ou sur un mot
# de passe bidon : voir les controles de src/config/environment.ts.
# Port d'ecoute HTTP du backend. Seule variable facultative : absente, elle vaut
# 3000. Doit etre compris entre 1024 et 65535 — le conteneur tourne en uid 1000,
# un port privilegie echouerait sur un EACCES au demarrage.
PORT=

DEMO_LAWYER_EMAIL=
DEMO_LAWYER_PASSWORD=
